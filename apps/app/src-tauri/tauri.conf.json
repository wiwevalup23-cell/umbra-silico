{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra Silico",
  "version": "0.0.3",
  "identifier": "app.umbra-silico.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Umbra Silico",
        "width": 1200,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:silicon-nostalgia.db"]
    }
  }
}
